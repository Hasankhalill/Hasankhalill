[
  {
    "name": "theme_info",
    "theme_name": "Hycare Supermarket",
    "theme_version": "1.0.0",
    "theme_author": "Hycare",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/manual/online-store/themes"
  },
  {
    "name": "t:settings_schema.logo.name",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:settings_schema.logo.help"
      },
      {
        "type": "text",
        "id": "brand_name",
        "label": "t:settings_schema.logo.brand"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:settings_schema.logo.image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "t:settings_schema.logo.width",
        "min": 60,
        "max": 240,
        "step": 10,
        "unit": "px",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings_schema.logo.favicon"
      }
    ]
  },
  {
    "name": "t:settings_schema.typography.name",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "t:settings_schema.typography.heading",
        "default": "fraunces_n6"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "t:settings_schema.typography.body",
        "default": "outfit_n4"
      }
    ]
  },
  {
    "name": "t:settings_schema.colors.name",
    "settings": [
      {
        "type": "color",
        "id": "accent_color",
        "label": "t:settings_schema.colors.accent",
        "default": "#E8A317"
      },
      {
        "type": "color_scheme",
        "id": "page_color_scheme",
        "label": "t:settings_schema.colors.page",
        "default": "scheme-1"
      },
      {
        "type": "range",
        "id": "page_width",
        "label": "t:settings_schema.colors.width",
        "min": 960,
        "max": 1440,
        "step": 20,
        "unit": "px",
        "default": 1180
      },
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "t:settings_schema.colors.background",
            "default": "#F4EFE3"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "t:settings_schema.colors.gradient",
            "info": "t:settings_schema.colors.gradient_info"
          },
          {
            "type": "color",
            "id": "text",
            "label": "t:settings_schema.colors.text",
            "default": "#16241C"
          },
          {
            "type": "color",
            "id": "button",
            "label": "t:settings_schema.colors.button",
            "default": "#1B4332"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "t:settings_schema.colors.button_label",
            "default": "#F4EFE3"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "t:settings_schema.colors.secondary",
            "default": "#1B4332"
          },
          {
            "type": "color",
            "id": "shadow",
            "label": "t:settings_schema.colors.shadow",
            "default": "#16241C"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "secondary_button_label",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "secondary_button_label"
        }
      }
    ]
  },
  {
    "name": "t:settings_schema.product.name",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "t:settings_schema.product.vendor",
        "default": true
      }
    ]
  },
  {
    "name": "t:settings_schema.social.name",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:settings_schema.social.help"
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "t:settings_schema.social.instagram"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "t:settings_schema.social.facebook"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "t:settings_schema.social.tiktok"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "t:settings_schema.social.youtube"
      }
    ]
  }
]
