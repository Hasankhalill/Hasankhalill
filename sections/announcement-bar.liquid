{%- if section.settings.text != blank -%}
  <div class="announce color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
    <p>
      {{ section.settings.text }}
      {%- if section.settings.link != blank and section.settings.link_label != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement.name",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.announcement.text",
      "default": "Browse every department. Prices and stock come from your Shopify catalog."
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.announcement.link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:sections.announcement.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.scheme",
      "default": "scheme-4"
    }
  ],
  "presets": [
    { "name": "t:sections.announcement.name" }
  ]
}
{% endschema %}
