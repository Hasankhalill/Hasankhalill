{%- liquid
  assign related_collection = collection
  if related_collection == blank and product.collections.size > 0
    assign related_collection = product.collections.first
  endif
-%}
{%- if related_collection != blank -%}
  {%- capture related_markup -%}
    {%- assign shown = 0 -%}
    {%- for related_product in related_collection.products limit: 8 -%}
      {%- if related_product.id != product.id and shown < 4 -%}
        <li>{% render 'product-card', product: related_product, eager: false %}</li>
        {%- assign shown = shown | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
{%- endif -%}
{%- assign related_markup_stripped = related_markup | strip -%}
{%- if related_markup_stripped != blank -%}
  <section class="band color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
    <div class="page-width">
      <h2>{{ section.settings.heading }}</h2>
      <ul class="product-grid">{{ related_markup }}</ul>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="band color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
    <div class="page-width">
      <p class="editor-note">{{ 'products.related_empty' | t }}</p>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.related.name",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "More from this aisle"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
