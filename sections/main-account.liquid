<section class="band color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="page-width">
    <h1>{{ 'customers.account_title' | t }}</h1>
    <p>{{ customer.name }}</p>
    <p>{{ customer.email }}</p>
    <p>
      <a href="{{ routes.account_addresses_url }}">{{ 'customers.addresses' | t }}</a>
      <a href="{{ routes.account_logout_url }}">{{ 'customers.logout' | t }}</a>
    </p>
    <h2>{{ 'customers.orders' | t }}</h2>
    {% paginate customer.orders by 20 %}
      {%- if customer.orders.size == 0 -%}
        <p>{{ 'customers.no_orders' | t }}</p>
      {%- else -%}
        <table class="account-table">
          <thead>
            <tr>
              <th>{{ 'customers.order' | t }}</th>
              <th>{{ 'customers.date' | t }}</th>
              <th>{{ 'customers.payment' | t }}</th>
              <th>{{ 'customers.fulfillment' | t }}</th>
              <th>{{ 'cart.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr>
                <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                <td>{{ order.created_at | date: format: 'date' }}</td>
                <td>{{ order.financial_status_label }}</td>
                <td>{{ order.fulfillment_status_label }}</td>
                <td>{{ order.total_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.account.name",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
