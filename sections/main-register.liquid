<section class="band color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="page-width page-narrow">
    <h1>{{ 'customers.register_title' | t }}</h1>
    {% form 'create_customer' %}
      {%- if form.errors -%}
        <div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="form-stack">
        <div>
          <label for="RegisterFirst">{{ 'customers.first_name' | t }}</label>
          <input id="RegisterFirst" type="text" name="customer[first_name]" autocomplete="given-name">
        </div>
        <div>
          <label for="RegisterLast">{{ 'customers.last_name' | t }}</label>
          <input id="RegisterLast" type="text" name="customer[last_name]" autocomplete="family-name">
        </div>
        <div>
          <label for="RegisterEmail">{{ 'customers.email' | t }}</label>
          <input id="RegisterEmail" type="email" name="customer[email]" autocomplete="email">
        </div>
        <div>
          <label for="RegisterPassword">{{ 'customers.password' | t }}</label>
          <input id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password">
        </div>
        <button class="button" type="submit">{{ 'customers.register' | t }}</button>
      </div>
    {% endform %}
    <p><a href="{{ routes.account_login_url }}">{{ 'customers.login' | t }}</a></p>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.register.name",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
