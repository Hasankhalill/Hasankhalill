{%- liquid
  assign has_details = false
  if section.settings.address != blank or section.settings.phone != blank or section.settings.email != blank or section.settings.hours != blank
    assign has_details = true
  endif
-%}
<section class="band color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="page-width page-narrow">
    <h1>{{ page.title }}</h1>
    {%- if section.settings.intro != blank -%}
      <div class="rte">{{ section.settings.intro }}</div>
    {%- endif -%}
    {%- if page.content != blank -%}
      <div class="rte">{{ page.content }}</div>
    {%- endif -%}
    {%- if has_details -%}
      <div class="contact-details">
        {%- if section.settings.address != blank -%}
          <div class="rte">{{ section.settings.address }}</div>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
          <p><a href="tel:{{ section.settings.phone | replace: ' ', '' }}">{{ section.settings.phone }}</a></p>
        {%- endif -%}
        {%- if section.settings.email != blank -%}
          <p><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
        {%- endif -%}
        {%- if section.settings.hours != blank -%}
          <div class="rte">{{ section.settings.hours }}</div>
        {%- endif -%}
      </div>
    {%- else -%}
      <p>{{ 'contact.details_empty' | t }}</p>
    {%- endif -%}
    {% form 'contact', id: 'ContactForm' %}
      {%- if form.posted_successfully? -%}
        <p role="status">{{ 'contact.success' | t }}</p>
      {%- endif -%}
      {%- if form.errors -%}
        <div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="form-stack">
        <div>
          <label for="ContactName">{{ 'contact.name' | t }}</label>
          <input id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
        </div>
        <div>
          <label for="ContactEmail">{{ 'contact.email' | t }}</label>
          <input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
        </div>
        <div>
          <label for="ContactPhone">{{ 'contact.phone' | t }}</label>
          <input id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{% if form.phone %}{{ form.phone }}{% endif %}">
        </div>
        <div>
          <label for="ContactBody">{{ 'contact.message' | t }}</label>
          <textarea id="ContactBody" name="contact[body]" required>{{ form.body }}</textarea>
        </div>
        <button class="button" type="submit">{{ 'contact.send' | t }}</button>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.contact.name",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:sections.contact.intro",
      "default": "<p>Send a message and the store will reply by email.</p>"
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "t:sections.contact.address"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "t:sections.contact.phone"
    },
    {
      "type": "text",
      "id": "email",
      "label": "t:sections.contact.email"
    },
    {
      "type": "richtext",
      "id": "hours",
      "label": "t:sections.contact.hours"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.scheme",
      "default": "scheme-3"
    }
  ]
}
{% endschema %}
