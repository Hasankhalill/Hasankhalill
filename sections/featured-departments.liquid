<section class="band dept-section dept-section--feature color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-intro">
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.intro != blank -%}
          <p>{{ section.settings.intro }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="feature-grid">
      {% content_for 'blocks' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured.name",
  "enabled_on": { "templates": ["index"] },
  "blocks": [{ "type": "_department" }],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Featured departments"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "t:sections.featured.intro",
      "default": "A short list of departments to open first. Add a photo in a block if you want one. The icon remains when no photo is set."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.scheme",
      "default": "scheme-4"
    }
  ],
  "presets": [
    { "name": "t:sections.featured.name" }
  ]
}
{% endschema %}
