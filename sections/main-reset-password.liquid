<section class="band color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="page-width page-narrow">
    <h1>{{ 'customers.reset_title' | t }}</h1>
    {% form 'reset_customer_password' %}
      {%- if form.errors -%}
        <div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="form-stack">
        <label for="ResetPassword">{{ 'customers.password' | t }}</label>
        <input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password">
        <label for="ResetPasswordConfirm">{{ 'customers.confirm_password' | t }}</label>
        <input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password">
        <button class="button" type="submit">{{ 'customers.reset' | t }}</button>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.reset.name",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
