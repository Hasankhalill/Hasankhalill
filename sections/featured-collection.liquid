{%- liquid
  assign featured = section.settings.collection
  assign show_rail = false
  if featured != blank and featured.products_count > 0
    assign show_rail = true
  endif
-%}
{%- if show_rail -%}
  <section class="band color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
    <div class="page-width">
      <h2>{{ section.settings.heading | default: featured.title }}</h2>
      <ul class="product-grid">
        {%- for product in featured.products limit: 4 -%}
          <li>{% render 'product-card', product: product, eager: false %}</li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="band color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
    <div class="page-width">
      <p class="editor-note">{{ 'collections.rail_empty' | t }}</p>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.rail.name",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Featured products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.rail.collection"
    },
    {
      "type": "paragraph",
      "content": "t:sections.rail.help"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    { "name": "t:sections.rail.name" }
  ]
}
{% endschema %}
