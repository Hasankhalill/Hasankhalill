<section class="band color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="page-width page-narrow">
    <h1>{% render 'brand-name' %}</h1>
    <div class="rte">{{ section.settings.text }}</div>
    {% form 'storefront_password' %}
      {%- if form.errors -%}
        <div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <label for="Password">{{ 'password.label' | t }}</label>
      <input id="Password" type="password" name="password" autocomplete="current-password">
      <button class="button" type="submit">{{ 'password.enter' | t }}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.password.name",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>This store is not open yet. Enter the password from Shopify to preview it.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.scheme",
      "default": "scheme-2"
    }
  ]
}
{% endschema %}
