{%- liquid
  assign current_sort = search.sort_by
  assign home_label = 'general.home' | t
-%}
<section class="band color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="page-width">
    <h1>
      {%- if search.performed -%}
        {{ 'search.results_title' | t: terms: search.terms }}
      {%- else -%}
        {{ 'search.title' | t }}
      {%- endif -%}
    </h1>
    <predictive-search class="predictive" data-predictive-url="{{ routes.predictive_search_url }}">
      <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
        <div class="search-form__field">
          <label for="SearchPage-{{ section.id }}">{{ 'search.label' | t }}</label>
          <input
            id="SearchPage-{{ section.id }}"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            role="combobox"
            aria-expanded="false"
            aria-controls="PredictivePage-{{ section.id }}"
            aria-autocomplete="list"
            autocomplete="off"
            placeholder="{{ 'search.placeholder' | t }}"
          >
        </div>
        <input type="hidden" name="options[prefix]" value="last">
        <button class="button" type="submit">{{ 'search.submit' | t }}</button>
        <div id="PredictivePage-{{ section.id }}" class="predictive__results" hidden></div>
      </form>
    </predictive-search>
    {%- if search.performed -%}
      {% render 'facets', filters: search.filters, sort_options: search.sort_options, sort_by: current_sort, action_url: routes.search_url, id_prefix: section.id, search_terms: search.terms %}
      {% paginate search.results by 16 %}
        {%- if search.results.size == 0 -%}
          {%- assign empty_title = 'search.empty_title' | t -%}
          {%- assign empty_text = 'search.empty_text' | t -%}
          {% render 'empty-state', title: empty_title, text: empty_text, link_url: routes.root_url, link_label: home_label %}
        {%- else -%}
          <p>{{ 'search.results_count' | t: count: search.results_count }}</p>
          <ul class="product-grid">
            {%- for item in search.results -%}
              <li>
                {%- if item.object_type == 'product' -%}
                  {% render 'product-card', product: item, eager: forloop.first %}
                {%- else -%}
                  <article class="card">
                    <a class="card__link" href="{{ item.url }}">
                      <div class="card__body">
                        <p class="eyebrow">
                          {%- if item.object_type == 'article' -%}
                            {{ 'search.article' | t }}
                          {%- elsif item.object_type == 'page' -%}
                            {{ 'search.page' | t }}
                          {%- elsif item.object_type == 'collection' -%}
                            {{ 'search.collection' | t }}
                          {%- else -%}
                            {{ item.object_type }}
                          {%- endif -%}
                        </p>
                        <h2 class="card__title">{{ item.title }}</h2>
                      </div>
                    </a>
                  </article>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {% endpaginate %}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.search.name",
  "enabled_on": { "templates": ["search"] },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
