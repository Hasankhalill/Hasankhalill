# Copy to .env and fill in. Never commit .env.

DATABASE_URL="postgresql://hycare:hycare@127.0.0.1:5432/hycare"
BETTER_AUTH_SECRET="replace-with-32-plus-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# First owner. Used only by `npm run bootstrap:owner`. Existing passwords are not reset.
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="replace-with-a-long-password"

STORE_TIMEZONE="Asia/Beirut"

# Email. If neither is set, messages are stored and were not sent.
RESEND_API_KEY=""
EMAIL_FROM="HyCare <orders@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# Images. Leave S3 unset to store files on local disk in development.
LOCAL_STORAGE_DIR="./storage/uploads"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# Optional Stripe test mode. This does not settle to Lebanese merchants.
# Orders are marked paid only after a verified webhook, never from the success URL.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Reserved for a future Lebanese acquirer. The Areeba provider does not capture.
AREEBA_MERCHANT_ID=""
AREEBA_API_KEY=""
