<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {{ page_title }}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: number: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    <link rel="canonical" href="{{ canonical_url }}">
    <meta name="theme-color" content="{{ settings.accent_color }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    {%- if page_description -%}
      <meta property="og:description" content="{{ page_description | escape }}">
    {%- endif -%}
    {%- if page_image -%}
      <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
    {%- endif -%}
    {% render 'head-assets' %}
    {{ content_for_header }}
  </head>
  <body class="color-{{ settings.page_color_scheme }} template-{{ template.name }}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip' | t }}</a>
    {% sections 'header-group' %}
    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    <script type="application/json" id="hycare-config">
      {
        "cartAdd": {{ routes.cart_add_url | json }},
        "cartJs": {{ routes.cart_url | append: '.js' | json }},
        "root": {{ routes.root_url | json }},
        "cartSection": "cart-drawer",
        "cartLabel": {{ 'header.cart_label' | t: count: '[[count]]' | json }}
      }
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
